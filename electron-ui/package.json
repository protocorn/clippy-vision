{
  "name": "clippy-vision",
  "productName": "Clippy Vision",
  "version": "2.1.0",
  "description": "Local AI desktop companion with screen awareness",
  "author": "Clippy Vision",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/protocorn/clippy-vision",
  "repository": {
    "type": "git",
    "url": "https://github.com/protocorn/clippy-vision.git"
  },
  "bugs": {
    "url": "https://github.com/protocorn/clippy-vision/issues"
  },
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test electron/lib/mcp.test.js electron/lib/setup.test.js",
    "lint:renderer": "eslint src/js",
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:all": "electron-builder --win --mac --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "dist:mac:all": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "dist:mac:dir": "electron-builder --mac --dir --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "keywords": [],
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "globals": "^16.5.0"
  },
  "build": {
    "appId": "com.clippyvision.app",
    "productName": "Clippy Vision",
    "copyright": "Copyright © Clippy Vision",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "clippy",
        "filter": [
          "api_server.py",
          "mcp_server.py",
          "requirements.txt",
          "pyproject.toml",
          "agent/**/*",
          "core/**/*",
          "classifier/**/*",
          "scripts/clippy-mcp",
          "scripts/clippy-mcp.cmd",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!core/data/**",
          "!**/*.db",
          "!**/*.db-wal",
          "!**/*.db-shm"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "ClippyVision-Windows-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "ClippyVision-macOS-${arch}-${version}.${ext}",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Clippy Vision captures the screen to keep a local memory of your work.",
        "NSAccessibilityUsageDescription": "Clippy Vision reads the front window so it can remember your work and cover passwords before a screenshot is saved."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clippy Vision",
      "uninstallDisplayName": "Clippy Vision",
      "include": "nsis/installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "ClippyVision-Linux-x86_64-${version}.${ext}"
    },
    "asar": true
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
