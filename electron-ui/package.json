{
  "name": "clippy-vision",
  "productName": "Clippy Vision",
  "version": "1.2.0",
  "description": "Local AI desktop companion with screen awareness",
  "author": "Clippy Vision",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:all": "electron-builder --win --mac",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:mac:all": "electron-builder --mac",
    "dist:dir": "electron-builder --dir",
    "dist:mac:dir": "electron-builder --mac --dir",
    "pack": "electron-builder --dir"
  },
  "keywords": [],
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.clippyvision.app",
    "productName": "Clippy Vision",
    "copyright": "Copyright © Clippy Vision",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "clippy",
        "filter": [
          "api_server.py",
          "requirements.txt",
          "pyproject.toml",
          "agent/**/*",
          "core/**/*",
          "classifier/**/*",
          "models/router_classifier/best/**/*",
          "models/embeddings/all-MiniLM-L6-v2/**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!core/data/**",
          "!**/*.db",
          "!**/*.db-wal",
          "!**/*.db-shm"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "ClippyVision-Windows-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "ClippyVision-macOS-${arch}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clippy Vision",
      "uninstallDisplayName": "Clippy Vision",
      "include": "nsis/installer.nsh"
    },
    "asar": true
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
